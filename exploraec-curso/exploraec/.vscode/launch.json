{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Proxy ExploraIA - Reglas",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/mock-server/mock-server.js",
            "console": "internalConsole",
            "env": {
                "GEMINI_API_KEY": "",
                "PORT": "3000",
                "MCP_URL": "http://localhost:8000/mcp/"
            }
        },
        {
            "name": "ExploraEC - Sesion 9 (Brave)",
            "type": "dart",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/lib/main.dart",
            "deviceId": "web-server",
            "flutterMode": "debug",
            "toolArgs": [
                "--web-port",
                "8186",
                "--dart-define=API_BASE_URL=http://localhost:8000",
                "--dart-define=LLM_BACKEND_URL=http://localhost:3000"
            ]
        }
    ]
}